# Copy to .env for local development. On Vercel, set these in Project > Settings > Environment Variables.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# PostgreSQL connection string (Neon, Supabase, Vercel Postgres...). Leave empty locally to use SQLite.
DATABASE_URL=
# Keep 1 until MRRH approves a locally validated model. Shows the demonstration banner on every page.
DEMO_MODE=1
# Optional: your own domain, comma separated
DJANGO_ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
